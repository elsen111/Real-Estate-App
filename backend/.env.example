# Spring profile
# "docker" = used inside the backend container (talks to service names)
# "dev"    = used when running the backend directly on your host
SPRING_PROFILES_ACTIVE=docker

# Database (Postgres)
# DB_HOST: "postgres" when the backend runs inside Docker Compose,
#          "localhost" when running the backend directly on your host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=real_estate_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Host-side port the Postgres container is published on.
# Change this if you already have a local Postgres on 5432.
POSTGRES_HOST_PORT=5432

# JWT
JWT_SECRET=replace-with-a-long-random-string

# Mail (SMTP - Gmail)
# Use a Gmail "App Password", not your normal account password.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# MinIO (S3-compatible object storage)
# MINIO_URL: "http://minio:9000" inside Docker, "http://localhost:9000" on host.
MINIO_URL=http://minio:9000
MINIO_USERNAME=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=estateflow
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancelled

# Backend container
BACKEND_HOST_PORT=8080